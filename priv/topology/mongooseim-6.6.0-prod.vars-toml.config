%%
%% AWFY-customized prod vars for MongooseIM 6.6.0, dropped on top of
%% rel/prod.vars-toml.config by Dockerfile.mongoose at build time.
%% Deltas from upstream:
%%   * hosts = []     — dynamic_domains_pm registers domains itself.
%%   * host_types = ["localhost"] + service_domain_db enabled — needed
%%     for the addDomain GraphQL mutation. service_domain_db hard-
%%     requires an RDBMS pool, so:
%%   * outgoing_pools.rdbms.default connected to the `postgres` service
%%     defined in priv/topology/local.compose.yml.
%% Everything else carries upstream defaults via the `./vars-toml.config`
%% include at the end of the file.

%% vm.args
{node_name, "mongooseim@localhost"}.
{highload_vm_args, "+P 10000000 -env ERL_MAX_PORTS 250000"}.

%% mongooseim.toml
{c2s_port, 5222}.
{outgoing_s2s_port, 5269}.
{incoming_s2s_port, 5269}.
{http_port, 5280}.
{https_port, 5285}.
{http_graphql_api_admin_endpoint_port, 5551}.
{http_graphql_api_domain_admin_endpoint_port, 5541}.
{http_graphql_api_user_endpoint_port, 5561}.
{http_api_endpoint_port, 8088}.
{http_api_client_endpoint_port, 8089}.
{http_prometheus_endpoint_port, 9091}.

{hosts, ""}.
{host_types, "\"localhost\""}.
{default_server_domain, "\"localhost\""}.
{s2s_default_policy, "\"deny\""}.
%% auth_method is overridden to "dummy" via a sed step on the included
%% rel/vars-toml.config in Dockerfile.mongoose — defining it here too
%% would race with that override (the include is read after these
%% entries and the template treats last-write-wins).

{service_domain_db, "  event_cleaning_interval = 1000"}.

{outgoing_pools, "[outgoing_pools.rdbms.default]
  scope = \"global\"
  workers = 5
  [outgoing_pools.rdbms.default.connection]
    driver = \"pgsql\"
    host = \"postgres\"
    port = 5432
    database = \"mongooseim\"
    username = \"mongooseim\"
    password = \"mongooseim_secret\"
    tls.required = false"}.

{listen_component, "[[listen.component]]
  port = 8888
  access = \"all\"
  shaper = \"fast\"
  ip_address = \"127.0.0.1\"
  password = \"secret\""}.

%% "" means that the module is enabled without any options
{mod_cache_users, ""}.
{mod_last, ""}.
{mod_offline, ""}.
{mod_privacy, ""}.
{mod_blocking, ""}.
{mod_private, ""}.
{tls_config, "tls.verify_mode = \"none\"
  tls.certfile = \"priv/ssl/fake_cert.pem\"
  tls.keyfile = \"priv/ssl/fake_key.pem\""}.

{instrumentation, "[instrumentation.prometheus]

[instrumentation.log]"}.

{erlang_doctor_limit, 1000}.

%% Include common vars shared by all profiles
"./vars-toml.config".
