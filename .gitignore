_build/
# `deps/` is anchored to repo root so the sub-app's vendored deps
# (apps/awfy_target_runner/deps/{benchee,...}/) stay tracked. Root
# /deps/ is mix-managed; we still ignore it.
/deps/
*.beam
erl_crash.dump
.elixir_ls/
results/
tmp/
node_modules/
# mix awfy.fill working dirs:
_pages/
_fill_results/

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/.terraform.lock.hcl
