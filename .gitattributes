# Pin line endings for sources whose hash is checked at runtime —
# `awfy.measure` records sha256 of each benchmark's `.ex`/`.erl`
# source. Without this, Windows checkouts get CRLF and produce
# different hashes than Linux/macOS, triggering "benchmark source
# changed" warnings in the dashboard.
*.ex   text eol=lf
*.exs  text eol=lf
*.erl  text eol=lf
*.hrl  text eol=lf
