# syntax=docker/dockerfile:1.6
#
# Minimal Linux benchmarking image for AWFY.
#
# Build args:
#   OTP_SHA          — git SHA on erlang/otp to build (resolved upfront)
#   ELIXIR_VERSION   — Elixir release tag (e.g. 1.19.5)
#   ELIXIR_OTP_MAJOR — OTP major the bundle was built for (26/27/28).
#                      Selects the elixir-otp-XX.zip download URL.
#                      Must match the OTP_SHA's major or `mix` will refuse
#                      to start. Elixir 1.19 dropped OTP 26 — caller picks
#                      1.18.5 for OTP 26 targets.
#
# The OTP build is intentionally trimmed to what AWFY exercises:
# no wx, odbc, observer, debugger, megaco, et — roughly halves the
# build time vs. a full OTP build, with no impact on benchmarks (they
# use only erts + stdlib + compiler + crypto).
#
# Layer caching strategy: BuildKit ccache mount means rebuilding for
# a small commit (a few `.c` files) takes 1-2 min after the first
# cold build (~10 min on a 4-core GHA runner).

ARG ELIXIR_VERSION=1.19.5
ARG ELIXIR_OTP_MAJOR=28

# Bullseye over Bookworm so we get OpenSSL 1.1.1 by default. OTP 27+
# builds fine against OpenSSL 3, but OTP < 23's crypto NIF uses APIs
# OpenSSL 3 deprecated/removed (RSA_get_key, EVP_MD_size, …), and the
# AWFY harness imports crypto for `:crypto.hash/2`. Staying on 1.1
# means OTP 20 → master all build with the same toolchain. Bullseye's
# Debian LTS support runs through 2026-08; revisit then.
FROM debian:bullseye-slim AS otp-build
ARG OTP_SHA

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential autoconf m4 \
        libssl-dev libncurses-dev zlib1g-dev \
        ca-certificates curl ccache patch \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/usr/lib/ccache:$PATH \
    CCACHE_DIR=/root/.ccache \
    ERL_TOP=/otp

# Patches/ is COPY'd separately from the source tarball so adding or
# editing a patch invalidates only this layer, not the whole build.
COPY patches/ /tmp/patches/

WORKDIR /tmp
RUN --mount=type=cache,target=/root/.ccache,sharing=locked \
    test -n "$OTP_SHA" || (echo "OTP_SHA build-arg required" && false) && \
    curl -fL "https://github.com/erlang/otp/archive/${OTP_SHA}.tar.gz" \
        | tar xz && \
    mv "otp-${OTP_SHA}" /otp && \
    cd /otp && \
    # Apply patches/OTP-<major>/*.patch matching this build's major.
    # See patches/README.md for the convention.
    if [ -f OTP_VERSION ]; then \
      OTP_MAJOR="$(head -1 OTP_VERSION | cut -d. -f1)"; \
    else \
      OTP_MAJOR="$ELIXIR_OTP_MAJOR"; \
    fi && \
    if [ -d "/tmp/patches/OTP-$OTP_MAJOR" ]; then \
      for p in /tmp/patches/OTP-$OTP_MAJOR/*.patch; do \
        [ -f "$p" ] || continue; \
        echo "Applying $p"; \
        patch -p1 < "$p"; \
      done; \
    fi && \
    # OTP source tarballs from /archive/<sha>.tar.gz only ship
    # `configure.in` for pre-OTP 25 releases — autoconf must run
    # first to generate `configure`. Modern OTP (≥ 25) ships
    # `configure` in the archive, so the test is a no-op there.
    if [ ! -x ./configure ]; then ./otp_build autoconf; fi && \
    ./configure \
        --prefix=/usr/local \
        --disable-debug \
        --without-javac \
        --without-wx \
        --without-odbc \
        --without-observer \
        --without-debugger \
        --without-megaco \
        --without-et \
        --without-jinterface && \
    make -j"$(nproc)" && \
    make install && \
    make -j"$(nproc)" FLAVOR=emu && \
    make FLAVOR=emu install && \
    # `make FLAVOR=emu install` doesn't always copy beam.emu into
    # /usr/local/lib/erlang/erts-VSN/bin/ on older OTPs — it lands in
    # the source tree's bin/<TARGET>/ but the install phase ships only
    # beam.smp. Without this copy `-emu_flavor emu` fails with
    # "Invalid flavor". Mirror what install-otp-source.sh does.
    erts_bin="$(ls -d /usr/local/lib/erlang/erts-*/bin 2>/dev/null | head -1)" && \
    if [ -n "$erts_bin" ]; then \
      for src in /otp/bin/*/beam.emu; do \
        [ -f "$src" ] || continue; \
        cp "$src" "$erts_bin/beam.emu"; \
        break; \
      done; \
    fi

# Build target beams for the AWFY suite + the target-runner harness
# using the *just-installed* erlc. They land at
# `/opt/awfy_target/awfy-0.1.0/{ebin,priv}` — under /opt/ rather than
# /usr/local/lib/ so they don't collide with the regular OTP-app
# lookup the host's `mix compile` does (the awfy app is also installed
# there as a path dep). The peer adds this dir explicitly via -pa.
COPY apps/awfy/src/         /tmp/awfy_src/
COPY apps/awfy/src_target/  /tmp/awfy_src_target/
COPY apps/awfy/priv/        /opt/awfy_target/awfy-0.1.0/priv/
RUN mkdir -p /opt/awfy_target/awfy-0.1.0/ebin && \
    /usr/local/bin/erlc -o /opt/awfy_target/awfy-0.1.0/ebin \
        /tmp/awfy_src/awfy_benchmark.erl \
        /tmp/awfy_src/awfy_random.erl \
        /tmp/awfy_src/awfy_som_vector.erl && \
    /usr/local/bin/erlc -pa /opt/awfy_target/awfy-0.1.0/ebin \
        -o /opt/awfy_target/awfy-0.1.0/ebin \
        /tmp/awfy_src/*.erl /tmp/awfy_src_target/*.erl

# In the app stage we'll pass /opt/awfy_target through verbatim so
# `awfy.measure` can find it via $AWFY_TARGET_BEAMS.

# Sanity: confirm `erl` runs. We don't try `-emu_flavor jit/emu` here —
# the available flavor names changed across OTP versions (OTP 26/27:
# `-emu_flavor smp`; OTP 28+: `jit`/`emu`). The benchmark child sets
# ERL_FLAGS per-version when emu is requested.
RUN /usr/local/bin/erl -noshell -eval 'io:format("erl ok ~s~n",[erlang:system_info(otp_release)]),halt()'

FROM debian:bullseye-slim AS app
ARG ELIXIR_VERSION
ARG ELIXIR_OTP_MAJOR

# Runtime deps only — no build chain in the final image. libssl1.1
# matches the build stage's Bullseye OpenSSL version.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl1.1 libncurses6 zlib1g \
        ca-certificates curl unzip git \
    && rm -rf /var/lib/apt/lists/*

# Carry over the OTP install + target beams from the build stage.
# The image ships the target beams under /opt/awfy_target/ ready to
# go, but doesn't auto-enable target-runner mode (no AWFY_TARGET_ERL
# in ENV). Callers that need it set both env vars at `docker run`
# time:
#
#   docker run -e AWFY_TARGET_ERL=/usr/local/bin/erl \
#              -e AWFY_TARGET_BEAMS=/opt/awfy_target/awfy-0.1.0/ebin \
#              <image> awfy.measure …
#
# The default (env unset) keeps the current isolated-peer flow,
# which runs Elixir benchmarks too — the right choice when target
# OTP has a compatible Elixir.
COPY --from=otp-build /usr/local /usr/local
COPY --from=otp-build /opt/awfy_target /opt/awfy_target
ENV PATH=/usr/local/bin:$PATH

# Install Elixir from the official precompiled bundle. The bundle name
# encodes the OTP major it was built against — caller picks the matching
# pair (Elixir 1.18 ships otp-26/27, Elixir 1.19 ships otp-27/28).
RUN curl -fL -o /tmp/elixir.zip \
        "https://github.com/elixir-lang/elixir/releases/download/v${ELIXIR_VERSION}/elixir-otp-${ELIXIR_OTP_MAJOR}.zip" \
    && unzip /tmp/elixir.zip -d /usr/local \
    && rm /tmp/elixir.zip

WORKDIR /app
# Mix needs each path-dep's mix.exs available before `deps.get` to
# resolve the dependency tree. Stage them alongside the root mix files
# so the deps layer caches independently of benchmark-source changes.
COPY mix.exs mix.lock ./
COPY apps/awfy/mix.exs apps/awfy/mix.exs
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get

COPY . .
RUN mix compile

# Smoke-test that the image actually runs: tiny 1s measurement on a
# fast benchmark catches missing shared libs, broken OTP build, etc.
# without waiting for a full ~5min sweep at runtime.
RUN mix awfy.measure --benchmarks Bounce --time 1 --warmup 0 \
        --ignore-preflight --label smoke --out /tmp/smoke && \
    rm -rf /tmp/smoke

# Default: full measurement run. Override with `docker run … <args>`.
ENTRYPOINT ["mix"]
CMD ["awfy.measure", "--ignore-preflight"]
