# syntax=docker/dockerfile:1.6
#
# Minimal Linux benchmarking image for AWFY.
#
# Build args:
#   OTP_SHA          — git SHA on erlang/otp to build (resolved upfront)
#   ELIXIR_VERSION   — Elixir release tag (e.g. 1.19.5)
#   ELIXIR_OTP_MAJOR — OTP major the bundle was built for (26/27/28).
#                      Selects the elixir-otp-XX.zip download URL.
#                      Must match the OTP_SHA's major or `mix` will refuse
#                      to start. Elixir 1.19 dropped OTP 26 — caller picks
#                      1.18.5 for OTP 26 targets.
#
# The OTP build is intentionally trimmed to what AWFY exercises:
# no wx, odbc, observer, debugger, megaco, et — roughly halves the
# build time vs. a full OTP build, with no impact on benchmarks (they
# use only erts + stdlib + compiler + crypto).
#
# Layer caching strategy: BuildKit ccache mount means rebuilding for
# a small commit (a few `.c` files) takes 1-2 min after the first
# cold build (~10 min on a 4-core GHA runner).

ARG ELIXIR_VERSION=1.19.5
ARG ELIXIR_OTP_MAJOR=28

# BASE_DISTRO selects the Debian base for both build and runtime
# stages. Two paths:
#
#   * Bullseye (OpenSSL 1.1.1, glibc 2.31, gcc 10) — the default. OTP
#     < 23's crypto NIF uses APIs OpenSSL 3 deprecated/removed
#     (RSA_get_key, EVP_MD_size, …) so old OTPs *must* build here.
#     Bullseye LTS support runs through 2026-08; revisit then.
#   * Trixie (OpenSSL 3.5, glibc 2.40, gcc 14) — for OTP 26+ where
#     downstream consumers (MongooseIM's fast_pbkdf2 NIF, others on
#     the application-bench path) call into OpenSSL 3 APIs that
#     aren't in Bullseye, and where the newer gcc is a meaningful
#     compiler-quality bump for the synthetic suite.
#
# The caller picks per-OTP from bench.yml's build-linux job (threshold
# = major >= 26 currently). Same distro is used for both build and
# runtime stages so glibc/libssl ABI matches between layers.
ARG BASE_DISTRO=bullseye
FROM debian:${BASE_DISTRO}-slim AS otp-build
ARG OTP_SHA
ARG OTP_REF=""
# Per-OTP extra configure flags. Resolve sets `--without-ssl` for
# OTP < 24 because: (a) those crypto NIFs reference OpenSSL 1.1
# APIs that OpenSSL 3 removed; (b) when the resulting image is
# extracted onto an Ubuntu 24.04 host (no libssl1.1 in its repos),
# crypto's on_load fails and any code path referencing `:crypto`
# crashes at runtime instead of just emitting a compile-time
# warning about an undefined function. AWFY benchmarks don't use
# crypto, and Elixir's bootstrap completes fine without it. Passed
# from `build-linux-target` as a build-arg.
ARG EXTRA_CONFIGURE=""

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential autoconf m4 \
        libssl-dev libncurses-dev zlib1g-dev \
        ca-certificates curl ccache patch \
        jq unzip \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/usr/lib/ccache:$PATH \
    CCACHE_DIR=/root/.ccache \
    ERL_TOP=/otp

# Patches/ and the source-fetch script are COPY'd separately from the
# source tarball so editing them invalidates only their own layer, not
# the whole build.
COPY patches/                   /tmp/patches/
COPY bin/fetch-otp-source.sh    /usr/local/bin/fetch-otp-source.sh

WORKDIR /tmp
RUN --mount=type=cache,target=/root/.ccache,sharing=locked \
    --mount=type=secret,id=gh_token \
    test -n "$OTP_SHA" || (echo "OTP_SHA build-arg required" && false) && \
    # Source resolution lives in the shared script — see its header
    # for the probe order. Every supported path produces a source
    # tree with a pre-generated `configure`, so we go straight to
    # ./configure below. The gh_token secret unlocks the
    # otp_prebuilt-artifact path for branch/SHA refs; without it
    # those refs simply fail (raw /archive isn't supported).
    if [ -s /run/secrets/gh_token ]; then \
        export GH_TOKEN="$(cat /run/secrets/gh_token)"; \
    fi && \
    /usr/local/bin/fetch-otp-source.sh "${OTP_REF:-$OTP_SHA}" "$OTP_SHA" /tmp && \
    mv /tmp/otp /otp && \
    cd /otp && \
    # Apply patches/OTP-<major>.<minor>/*.patch matching this build's
    # function-release line. See patches/README.md for the convention.
    if [ -f OTP_VERSION ]; then \
      OTP_MAJOR_MINOR="$(head -1 OTP_VERSION | cut -d. -f1-2)"; \
    else \
      OTP_MAJOR_MINOR="$ELIXIR_OTP_MAJOR"; \
    fi && \
    if [ -d "/tmp/patches/OTP-$OTP_MAJOR_MINOR" ]; then \
      for p in /tmp/patches/OTP-$OTP_MAJOR_MINOR/*.patch; do \
        [ -f "$p" ] || continue; \
        echo "Applying $p"; patch -p1 -N < "$p"; \
      done; \
    fi && \
    # shellcheck disable=SC2086 # EXTRA_CONFIGURE is intentionally
    # word-split so multiple flags can be passed as a single arg.
    #
    # CFLAGS="-O2 -fcommon" — two ingredients:
    #
    #   * `-O2` re-asserts the optimization level autoconf would
    #     pick for us if we left CFLAGS unset. The moment we touch
    #     CFLAGS, autoconf stops injecting its `-g -O2` default and
    #     OTP's configure starts failing tests that depend on
    #     optimisation (e.g. inline asm probes that the compiler
    #     elides at -O0). So when we override CFLAGS we have to
    #     replicate the optimisation level.
    #   * `-fcommon` restores the pre-GCC-10 lenient behaviour for
    #     tentative definitions (variables declared in a header
    #     without `extern`). OTP < 23 source has several such
    #     declarations (e.g. `erts_allctr_wrappers` in
    #     erts/emulator/beam/erl_alloc.h for OTP 20,
    #     `ei_default_socket_callbacks` in
    #     lib/erl_interface/src/misc/ei_portio.h for OTP 22) that
    #     fail to link under Bullseye's GCC 10's default
    #     `-fno-common`. The flag is a no-op for OTP ≥ 23 source
    #     where the declarations are properly `extern`-qualified,
    #     so we apply it globally rather than gating per-version
    #     through another build-arg.
    CFLAGS="-O2 -fcommon ${CFLAGS:-}" \
    ./configure \
        --prefix=/usr/local \
        --disable-debug \
        --without-javac \
        --without-wx \
        --without-odbc \
        --without-observer \
        --without-debugger \
        --without-megaco \
        --without-et \
        --without-jinterface \
        ${EXTRA_CONFIGURE} && \
    make -j"$(nproc)" && \
    make install && \
    # Record the perf-relevant build inputs so awfy.measure can lift
    # them into meta.json (and the dashboard's machine-specs card).
    # Mirror of bin/install-otp-source-mac.sh — skip --without-* and
    # --disable-debug noise, keep CFLAGS + caller-supplied extras.
    { \
      printf 'CFLAGS="-O2 -fcommon %s"\n' "${CFLAGS:-}"; \
      [ -n "${EXTRA_CONFIGURE:-}" ] && printf '%s\n' "${EXTRA_CONFIGURE}"; \
      true; \
    } > /usr/local/awfy_build_config.txt && \
    # Honest compiler identity — same reason as the macOS install
    # script: erlang:system_info(c_compiler_used) reads __GNUC__ which
    # any clang-pretending-to-be-gcc lies about. `$CC --version` is
    # the truth. awfy.measure prefers this file when set.
    ("${CC:-cc}" --version 2>/dev/null | head -1 > /usr/local/awfy_compiler.txt || true) && \
    make -j"$(nproc)" FLAVOR=emu && \
    make FLAVOR=emu install && \
    # `make FLAVOR=emu install` doesn't always copy beam.emu into
    # /usr/local/lib/erlang/erts-VSN/bin/ on older OTPs — it lands in
    # the source tree's bin/<TARGET>/ but the install phase ships only
    # beam.smp. Without this copy `-emu_flavor emu` fails with
    # "Invalid flavor". Mirror what install-otp-source-mac.sh does.
    erts_bin="$(ls -d /usr/local/lib/erlang/erts-*/bin 2>/dev/null | head -1)" && \
    if [ -n "$erts_bin" ]; then \
      for src in /otp/bin/*/beam.emu; do \
        [ -f "$src" ] || continue; \
        cp "$src" "$erts_bin/beam.emu"; \
        break; \
      done; \
    fi

# Build target benchmark beams using the *just-installed* erlc.
# They land at `/opt/awfy_target/awfy-0.1.0/{ebin,priv}` — alongside
# the OTP install at /usr/local rather than under it so the
# target-runner-mode caller can pass them via -pa without colliding
# with the host's `mix compile`-installed `awfy` app. The legacy
# Erlang harness under `apps/awfy/src_target/` was retired in
# Phase 3 of PLAN/TARGET_ELIXIR_RUNNER_PLAN.md; this stage now
# compiles only the benchmark sources. AWS bare-metal extracts both
# /usr/local and /opt/awfy_target via bin/extract-otp-from-image.sh.
COPY apps/awfy/src/         /tmp/awfy_src/
COPY apps/awfy/priv/        /opt/awfy_target/awfy-0.1.0/priv/
RUN mkdir -p /opt/awfy_target/awfy-0.1.0/ebin && \
    /usr/local/bin/erlc -o /opt/awfy_target/awfy-0.1.0/ebin \
        /tmp/awfy_src/awfy_benchmark.erl \
        /tmp/awfy_src/awfy_random.erl \
        /tmp/awfy_src/awfy_som_vector.erl && \
    /usr/local/bin/erlc -pa /opt/awfy_target/awfy-0.1.0/ebin \
        -o /opt/awfy_target/awfy-0.1.0/ebin \
        /tmp/awfy_src/*.erl

# Two output trees from the build stage:
#   * /usr/local — OTP install (bin/erl, lib/erlang/...).
#   * /opt/awfy_target/awfy-0.1.0 — target-erlc-compiled benchmarks.
# Both get COPY'd into the app stage below; bin/extract-otp-from-
# image.sh pulls both onto the host for the AWS bare-metal flow.

# Sanity: confirm `erl` runs. We don't try `-emu_flavor jit/emu` here —
# the available flavor names changed across OTP versions (OTP 26/27:
# `-emu_flavor smp`; OTP 28+: `jit`/`emu`). The benchmark child sets
# ERL_FLAGS per-version when emu is requested.
RUN /usr/local/bin/erl -noshell -eval 'io:format("erl ok ~s~n",[erlang:system_info(otp_release)]),halt()'

ARG BASE_DISTRO=bullseye
FROM debian:${BASE_DISTRO}-slim AS app
ARG ELIXIR_VERSION
ARG ELIXIR_OTP_MAJOR

# Runtime deps only — no build chain in the final image. libssl
# version follows BASE_DISTRO: Bullseye has libssl1.1, Bookworm
# has libssl3, Trixie has libssl3 (3.5). The `||` fallback lets
# the install succeed on whichever variant the chosen distro
# ships; the build stage's OTP was linked against the same one.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libncurses6 zlib1g \
        ca-certificates curl unzip git \
    && (apt-get install -y --no-install-recommends libssl3 \
        || apt-get install -y --no-install-recommends libssl1.1) \
    && rm -rf /var/lib/apt/lists/*

# Carry over both the OTP install and target benchmark beams from
# the build stage. The image ships the target beams under
# /opt/awfy_target/ ready to go, but doesn't auto-enable
# target-runner mode (no AWFY_TARGET_ERL in ENV). Callers that need
# it set the env vars at `docker run` time:
#
#   docker run -e AWFY_TARGET_ERL=/usr/local/bin/erl \
#              -e AWFY_TARGET_BEAMS=/opt/awfy_target/awfy-0.1.0/ebin \
#              <image> awfy.measure …
#
# The default (env unset) keeps the isolated-peer flow, which runs
# Elixir benchmarks too — the right choice when target OTP has a
# compatible Elixir.
COPY --from=otp-build /usr/local /usr/local
COPY --from=otp-build /opt/awfy_target /opt/awfy_target
ENV PATH=/usr/local/bin:$PATH

# Install Elixir from the official precompiled bundle. The bundle name
# encodes the OTP major it was built against — caller picks the matching
# pair (Elixir 1.18 ships otp-26/27, Elixir 1.19 ships otp-27/28).
RUN curl -fL -o /tmp/elixir.zip \
        "https://github.com/elixir-lang/elixir/releases/download/v${ELIXIR_VERSION}/elixir-otp-${ELIXIR_OTP_MAJOR}.zip" \
    && unzip /tmp/elixir.zip -d /usr/local \
    && rm /tmp/elixir.zip

WORKDIR /app
# Mix needs each path-dep's mix.exs available before `deps.get` to
# resolve the dependency tree. Stage them alongside the root mix files
# so the deps layer caches independently of benchmark-source changes.
COPY mix.exs mix.lock ./
COPY apps/awfy/mix.exs apps/awfy/mix.exs
RUN mix local.hex --force && \
    mix local.rebar --force && \
    mix deps.get

COPY . .
RUN mix compile

# Smoke-test that the image actually runs: tiny 1s measurement on a
# fast benchmark catches missing shared libs, broken OTP build, etc.
# without waiting for a full ~5min sweep at runtime.
RUN mix awfy.measure --benchmarks Bounce --time 1 --warmup 0 \
        --ignore-preflight --label smoke --out /tmp/smoke && \
    rm -rf /tmp/smoke

# Default: full measurement run. Override with `docker run … <args>`.
ENTRYPOINT ["mix"]
CMD ["awfy.measure", "--ignore-preflight"]
