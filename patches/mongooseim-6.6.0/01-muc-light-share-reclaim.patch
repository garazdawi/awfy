+
+%% #75 global-heap prototype hook. When started with `-share_muc true`, promote
+%% the groupchat payload into the shared literal range once per message
+%% (erts_debug:share/1) so the fan-out routes reference it instead of copying it
+%% to every occupant; every N messages, reclaim released areas
+%% (erts_debug:reclaim_shared/0) so the shared area stays bounded. Disabled (and
+%% zero-overhead: one persistent_term read) by default. A/B is a runtime flag on
+%% one image, so the same build measures both arms.
+-define(MIM_SHARE_RECLAIM_EVERY, 500).
+mim_muc_light_maybe_share(Children) ->
+    case persistent_term:get(mim_muc_share_cfg, undefined) of
+        undefined ->
+            Enabled = case init:get_argument(share_muc) of
+                          {ok, [["true" | _] | _]} -> true;
+                          _ -> false
+                      end,
+            Ctr = counters:new(1, [write_concurrency]),
+            persistent_term:put(mim_muc_share_cfg, {Enabled, Ctr}),
+            mim_muc_light_maybe_share(Children);
+        {false, _} ->
+            Children;
+        {true, Ctr} ->
+            counters:add(Ctr, 1, 1),
+            case counters:get(Ctr, 1) rem ?MIM_SHARE_RECLAIM_EVERY of
+                0 -> catch erts_debug:reclaim_shared();
+                _ -> ok
+            end,
+            erts_debug:share(Children)
+    end.
