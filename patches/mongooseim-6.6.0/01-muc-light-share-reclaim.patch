+%% #75 term-heavy fan-out control. Real groupchat stanzas are tiny, so their
+%% fan-out copy tax is negligible. To measure the shared-heap mechanism in the
+%% real broker where the tax lives, `-muc_inflate K` appends K synthetic child
+%% elements to every groupchat payload (applied to BOTH A/B arms, so `off`
+%% copies the K-element term to each occupant and `on` references it — the
+%% pattern benchmark's shape, in-broker). K=0 (default) = untouched.
+mim_muc_light_inflate(Children) ->
+    case persistent_term:get(mim_muc_inflate_k, undefined) of
+        undefined ->
+            Kv = case init:get_argument(muc_inflate) of
+                     {ok, [[Ks | _] | _]} ->
+                         case catch list_to_integer(Ks) of
+                             N when is_integer(N), N > 0 -> N;
+                             _ -> 0
+                         end;
+                     _ -> 0
+                 end,
+            persistent_term:put(mim_muc_inflate_k, Kv),
+            %% First groupchat message through the modern codec — proves this
+            %% hook (and codec) is actually on the fan-out path.
+            logger:error("MIM_INFLATE_INIT k=~p", [Kv]),
+            mim_muc_light_inflate(Children);
+        0 -> Children;
+        K ->
+            Extra = [{xmlel, <<"hist">>,
+                      [{<<"i">>, integer_to_binary(I)}],
+                      [{xmlcdata, <<"forwarded history line ",
+                                    (integer_to_binary(I))/binary>>}]}
+                     || I <- lists:seq(1, K)],
+            Children ++ Extra
+    end.
+
+%% #75 global-heap prototype hook. When started with `-share_muc true`, promote
+%% the groupchat payload into the shared literal range once per message
+%% (erts_debug:share/1) so the fan-out routes reference it instead of copying it
+%% to every occupant; every N messages, reclaim released areas
+%% (erts_debug:reclaim_shared/0) so the shared area stays bounded. Disabled (and
+%% zero-overhead: one persistent_term read) by default. A/B is a runtime flag on
+%% one image, so the same build measures both arms.
+-define(MIM_SHARE_RECLAIM_EVERY, 100).
+mim_muc_light_maybe_share(Children) ->
+    case persistent_term:get(mim_muc_share_cfg, undefined) of
+        undefined ->
+            Enabled = case init:get_argument(share_muc) of
+                          {ok, [["true" | _] | _]} -> true;
+                          _ -> false
+                      end,
+            Ctr = counters:new(1, [write_concurrency]),
+            persistent_term:put(mim_muc_share_cfg, {Enabled, Ctr}),
+            logger:error("MIM_SHARE_INIT enabled=~p", [Enabled]),
+            mim_muc_light_maybe_share(Children);
+        {false, _} ->
+            Children;
+        {true, Ctr} ->
+            counters:add(Ctr, 1, 1),
+            N = counters:get(Ctr, 1),
+            case N of
+                1 -> logger:error("MIM_SHARE_FIRED first groupchat payload shared");
+                _ -> ok
+            end,
+            case N rem ?MIM_SHARE_RECLAIM_EVERY of
+                0 ->
+                    Reclaim = (catch erts_debug:reclaim_shared()),
+                    Info = (catch erts_debug:shared_info()),
+                    %% Proof the hook fired + how much was shared/reclaimed
+                    %% (captured from the broker's docker logs by the harness).
+                    logger:error("MIM_SHARE msgs=~p reclaim=~p shared_info=~p",
+                                 [N, Reclaim, Info]);
+                _ -> ok
+            end,
+            erts_debug:share(Children)
+    end.
