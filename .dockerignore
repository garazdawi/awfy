# Exclude transient + large files that have no business in any
# build context (cuts the XMPP-bench compose-up context from
# >700 MB to ~MB; previously the legacy docker builder choked on
# it). Exclusion-based rather than allow-listed so Dockerfile.linux
# keeps seeing the rest of the repo (apps/, bin/, mix.exs, …).

# Local benchmark output — multi-GB and per-machine.
results/

# Elixir / mix output. mix.lock + mix.exs *are* needed; the build
# directories aren't.
_build/
deps/

# Cross-OTP bundle tarballs cached at the repo root by
# bin/refresh-target-deps.sh — never wanted in a build.
target_bundle_*.tar.gz

# Node / JS toolchains, if any.
node_modules/
