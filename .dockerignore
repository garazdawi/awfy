# Default-exclude everything; the XMPP-bench Dockerfiles fetch upstream
# source via curl and only need a tiny slice of the repo (patches/) for
# COPY. Sending the full repo as build context pushed >700 MB on first
# run because results/, _build/, deps/, tarballs and .git all rode
# along, and the legacy docker builder choked partway through. Whitelist
# explicitly what the build actually consumes.
*

# What the Dockerfiles actually COPY:
!Dockerfile.mongoose
!Dockerfile.amoc
!patches/
patches/OTP-*/
!priv/topology/
# The compose YAML itself never rides into a build context, only the
# config overlays do; excluding it keeps the .yml out of cache keys.
priv/topology/local.compose.yml

# Re-exclude OTP patches (they're large and not for these images).
# patches/mongooseim-<pin>/ and patches/amoc-<pin>/ stay included if
# they exist; otherwise the COPY targets nothing and `if [ -d ]`
# guards in the RUN steps see no files.
