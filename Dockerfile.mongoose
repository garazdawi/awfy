# Per-pin MongooseIM image for the XMPP application-level benchmark.
# See PLAN/MONGOOSEIM_BENCH_PLAN.md.
#
# Phase 1: builds against a public Erlang base image (debian-bookworm)
# at the OTP version Amoc is pinned to. Phase 2 will repoint the
# FROM line at the AWFY per-ref OTP image so each broker measures
# against a specific target OTP. Until then this gives us a working
# end-to-end pipeline with one fixed OTP version.
#
# Build args:
#   MIM_PIN          — MongooseIM git tag or SHA. Defaults to the
#                      contents of priv/mongooseim-pin.txt; build
#                      caller passes the resolved value as a flag.
#   OTP_VERSION      — OTP major.minor for the base image. Phase 1
#                      tracks priv/amoc-otp-version.txt so the
#                      build base matches the load-gen base.
#
# Cache key: (MIM_PIN, OTP_VERSION, patches/mongooseim-<pin>/ hash).
# Image tag (pushed by CI):
#   ghcr.io/<repo>:mongooseim-<otp_version>-<mim_pin>

ARG OTP_VERSION=27.3
FROM erlang:${OTP_VERSION} AS build

ARG MIM_PIN=6.6.0
ENV DEBIAN_FRONTEND=noninteractive

# MongooseIM build deps. libssl-dev for crypto NIFs, libexpat1-dev for
# XML parsing, unixodbc-dev because the build stages it even though
# we won't enable RDBMS at runtime in Phase 1.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libssl-dev \
        libexpat1-dev \
        unixodbc-dev \
        zlib1g-dev \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl -fsSL "https://github.com/esl/MongooseIM/archive/refs/tags/${MIM_PIN}.tar.gz" \
        | tar xz --strip-components=1

# Apply any compat patches under patches/mongooseim-<pin>/ ahead of
# the build. Empty when MongooseIM builds clean against the target
# OTP; populated when upstream lags an OTP change.
COPY patches/mongooseim-${MIM_PIN}/ /tmp/patches/
RUN if [ -d /tmp/patches ] && ls /tmp/patches/*.patch >/dev/null 2>&1; then \
        for p in /tmp/patches/*.patch; do \
            echo "Applying $p"; \
            patch -p1 -N < "$p"; \
        done; \
    fi

# Disable MongooseIM's system_metrics telemetry. The default ships
# with `report = true` (uncommented section header, implicit default),
# which prints a multi-line `report_transparency` warning to the log
# every boot and POSTs an anonymous metrics report to ESL's collector.
# Neither belongs in a controlled benchmark run — the warning eats log
# lines we care about, and an outbound POST adds non-determinism.
RUN awk '/^\[services.service_mongoose_system_metrics\]/{print; print "  report = false"; next} {print}' \
        rel/files/mongooseim.toml > rel/files/mongooseim.toml.new \
    && mv rel/files/mongooseim.toml.new rel/files/mongooseim.toml

# Enable the bits amoc-arsenal-xmpp's `dynamic_domains_pm` scenario
# needs from MongooseIM:
#
#   1. Admin GraphQL endpoint reachable from outside loopback —
#      default ships at `ip_address = "127.0.0.1"` in vars-toml.config
#      (rendered into `[[listen.http]]` of mongooseim.toml). The
#      values are stored as Erlang string literals with escaped
#      quotes (`\"127.0.0.1\"`), so the sed pattern matches the
#      backslash form.
#   2. `host = "localhost"` on the admin GraphQL handler is Cowboy's
#      vhost filter — rejects requests whose Host header doesn't
#      equal "localhost". The amoc-worker dials `mongooseim:5551`, so
#      Host arrives as "mongooseim" and the handler returns nothing.
#      Replace with `host = "_"` (wildcard) — same as MongooseIM
#      already uses for the domain-admin + user GraphQL handlers.
#      Other `host = "localhost"` entries in mongooseim.toml live on
#      commented-out example lines (mod_register clause + s2s allow
#      rule), so the leading-whitespace anchor keeps the swap scoped.
#   3. `service_domain_db` and `host_types` aren't declared in
#      prod.vars-toml.config, so the Mustache block in mongooseim.toml
#      stays unrendered and the `addDomain` GraphQL mutation fails
#      with `deps_not_loaded`. Add minimal config so dynamic domains
#      work; the scenario's default `host_type = <<"localhost">>`
#      then has a matching type to register against.
RUN sed -i 's#ip_address = \\"127.0.0.1\\"#ip_address = \\"0.0.0.0\\"#g' rel/vars-toml.config \
    && sed -i 's#^    host = "localhost"#    host = "_"#' rel/files/mongooseim.toml \
    && sed -i 's#^{hosts, .*}\.$#{hosts, ""}.\n{host_types, "\\"localhost\\""}.\n{service_domain_db, "  event_cleaning_interval = 1000"}.#' \
        rel/prod.vars-toml.config

# `./tools/configure with-all` writes configure.out + reltool vars.
# Defaults are fine for an in-memory single-node setup. `make rel`
# produces _build/prod/rel/mongooseim/.
RUN ./tools/configure with-all
RUN make rel

# --- runtime stage ---------------------------------------------------
FROM erlang:${OTP_VERSION}-slim AS runtime

# Same NIF runtime deps as the build stage minus the -dev packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libssl3 \
        libexpat1 \
        libodbc2 \
        zlib1g \
        ca-certificates \
        procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mongooseim
COPY --from=build /build/_build/prod/rel/mongooseim/ ./

# c2s on 5222 (XMPP), mongooseimctl uses the internal distribution
# socket which doesn't need to be exposed.
EXPOSE 5222

# `foreground` keeps mongooseimctl attached to the container's
# stdout/stderr, so Docker can manage the lifecycle and we can stream
# logs back to the host runner.
ENTRYPOINT ["./bin/mongooseimctl", "foreground"]
