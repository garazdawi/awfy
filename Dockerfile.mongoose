# Per-pin MongooseIM image for the XMPP application-level benchmark.
# See PLAN/MONGOOSEIM_BENCH_PLAN.md.
#
# Phase 1: builds against a public Erlang base image (debian-bookworm)
# at the OTP version Amoc is pinned to. Phase 2 will repoint the
# FROM line at the AWFY per-ref OTP image so each broker measures
# against a specific target OTP. Until then this gives us a working
# end-to-end pipeline with one fixed OTP version.
#
# Build args:
#   MIM_PIN          — MongooseIM git tag or SHA. Defaults to the
#                      contents of priv/mongooseim-pin.txt; build
#                      caller passes the resolved value as a flag.
#   OTP_VERSION      — OTP major.minor for the base image. Phase 1
#                      tracks priv/amoc-otp-version.txt so the
#                      build base matches the load-gen base.
#
# Cache key: (MIM_PIN, OTP_VERSION, patches/mongooseim-<pin>/ hash).
# Image tag (pushed by CI):
#   ghcr.io/<repo>:mongooseim-<otp_version>-<mim_pin>

ARG OTP_VERSION=27.3
# BASE_IMAGE / RUNTIME_IMAGE override the default Docker Hub erlang
# tags. Used by the CI XMPP leg to point at the per-OTP AWFY image
# (`ghcr.io/<repo>:<sha>-<arch>`) — that path covers OTP refs Docker
# Hub doesn't have a tag for (master, maint-XX, RCs) and keeps the
# broker measuring against the *exact* OTP build AWFY tests.
# Default keeps the local-dev path on Docker Hub `erlang:<tag>` (no
# need to pre-build an AWFY image for the local dev/smoke loop).
ARG BASE_IMAGE=erlang:${OTP_VERSION}
ARG RUNTIME_IMAGE=erlang:${OTP_VERSION}-slim
FROM ${BASE_IMAGE} AS build

ARG MIM_PIN=6.6.0
ENV DEBIAN_FRONTEND=noninteractive

# MongooseIM build deps. libssl-dev for crypto NIFs, libexpat1-dev for
# XML parsing, unixodbc-dev because the build stages it even though
# we won't enable RDBMS at runtime in Phase 1.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        libssl-dev \
        libexpat1-dev \
        unixodbc-dev \
        zlib1g-dev \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN curl -fsSL "https://github.com/esl/MongooseIM/archive/refs/tags/${MIM_PIN}.tar.gz" \
        | tar xz --strip-components=1

# Apply any compat patches under patches/mongooseim-<pin>/ ahead of
# the build. Empty when MongooseIM builds clean against the target
# OTP; populated when upstream lags an OTP change.
COPY patches/mongooseim-${MIM_PIN}/ /tmp/patches/
RUN if [ -d /tmp/patches ] && ls /tmp/patches/*.patch >/dev/null 2>&1; then \
        for p in /tmp/patches/*.patch; do \
            echo "Applying $p"; \
            patch -p1 -N < "$p"; \
        done; \
    fi

# Disable MongooseIM's system_metrics telemetry. The default ships
# with `report = true` (uncommented section header, implicit default),
# which prints a multi-line `report_transparency` warning to the log
# every boot and POSTs an anonymous metrics report to ESL's collector.
# Neither belongs in a controlled benchmark run — the warning eats log
# lines we care about, and an outbound POST adds non-determinism.
RUN awk '/^\[services.service_mongoose_system_metrics\]/{print; print "  report = false"; next} {print}' \
        rel/files/mongooseim.toml > rel/files/mongooseim.toml.new \
    && mv rel/files/mongooseim.toml.new rel/files/mongooseim.toml

# Open the admin GraphQL endpoint to in-cluster callers. Defaults:
#   * `ip_address = "127.0.0.1"` in vars-toml.config (rendered into
#     `[[listen.http]]`) — loopback-only, so amoc-worker can't reach
#     the listener over the docker bridge. Stored as Erlang string
#     literals with escaped quotes (`\"127.0.0.1\"`), so the sed
#     pattern matches the backslash form.
#   * `host = "localhost"` on the admin GraphQL handler is Cowboy's
#     vhost filter — rejects requests whose Host header doesn't equal
#     "localhost". amoc-worker dials `mongooseim:5551`, so Host
#     arrives as "mongooseim" and the handler returns nothing. Swap
#     to `host = "_"` (wildcard); the other graphql handlers already
#     use that. Anchor on leading whitespace so the substitution
#     doesn't touch the commented-out mod_register/s2s examples that
#     also contain `host = "localhost"`.
RUN sed -i 's#ip_address = \\"127.0.0.1\\"#ip_address = \\"0.0.0.0\\"#g' rel/vars-toml.config \
    && sed -i 's#^    host = "localhost"#    host = "_"#' rel/files/mongooseim.toml \
    && sed -i 's#^{auth_method, .*}\.$#{auth_method, "dummy"}.#' rel/vars-toml.config

# Enable [internal_databases.cets] alongside Mnesia. The included
# rel/vars-toml.config defines `{internal_databases, "[internal_databases.mnesia]"}`
# and vars-toml processing is last-write-wins, so the override has
# to land in the included file itself rather than in the prod
# vars-toml profile. Heredoc avoids the sed-escaping nightmare a
# literal Erlang-string-of-escaped-TOML would otherwise require.
# `cluster_name` keys the discovery_nodes row each broker writes on
# boot — any node writing the same name into the table joins the
# same logical CETS cluster.
RUN sed -i '/^{internal_databases,/d' rel/vars-toml.config \
    && cat >> rel/vars-toml.config <<'EOF'
{internal_databases, "[internal_databases.mnesia]\n\n[internal_databases.cets]\n  backend = \"rdbms\"\n  cluster_name = \"awfy_xmpp\""}.
EOF

# Drop the @host suffix off -sname and pin -setcookie to a shared
# cluster value. The same image runs as 3 distinct broker containers
# in the CETS topology; with `-sname mongooseim` (no @host suffix),
# each BEAM resolves its own node name as `mongooseim@$HOSTNAME`, and
# docker-compose's per-service `hostname:` value gives each broker a
# distinct identity (mongooseim-1 / -2 / -3) — no per-container
# vm.args mutation needed. Cookie is shared across the three so BEAM
# distribution authentication clears.
#
# Removing -setcookie entirely was the first attempt; mongooseimctl's
# boot-time guard greps vm.args for it and exits 1 with "vm.args
# needs to have a -setcookie parameter" without one. Keeping the
# value in the file also avoids relying on duplicate-flag last-wins
# semantics across OTP versions.
RUN sed -i 's/^-sname .*/-sname mongooseim/' rel/files/vm.args \
    && sed -i 's/^-setcookie .*/-setcookie awfy_xmpp_cluster/' rel/files/vm.args

# Drop in our customised prod.vars-toml.config to:
#   * Empty `hosts` and declare `host_types = ["localhost"]` so
#     `dynamic_domains_pm`'s default `host_type = <<"localhost">>` has
#     a matching type to register against.
#   * Enable `service_domain_db` (without it, the `addDomain` GraphQL
#     mutation answers `deps_not_loaded`).
#   * Configure an `outgoing_pools.rdbms.global` pool pointing at the
#     `postgres` compose service — service_domain_db hard-requires an
#     RDBMS pool. The schema is loaded into postgres via the init.d
#     mount in priv/topology/local.compose.yml.
COPY priv/topology/mongooseim-${MIM_PIN}-prod.vars-toml.config \
     rel/prod.vars-toml.config

# MongooseIM bundles a rebar3 escript whose precompiled .beam files
# were built against an older OTP. On OTP 29 the BEAM loader refuses
# to load them ("please re-compile this module with an Erlang/OTP 29
# compiler"), so `./rebar3 as prod release` dies before any actual
# build work runs. Bootstrap a fresh rebar3 from source against the
# current base OTP and drop it on top.
#
# `./bootstrap` is rebar3's own zero-deps build script — only uses
# `erl` (no rebar3 needed to build rebar3). 3.24.0 is the current
# stable line; bump on the same cadence as MongooseIM's bundle. A
# pin matters here so a transient `master` rebar3 regression can't
# tank the MongooseIM image build.
#
# Suppress the OTP-29/master warnings the build trips that get
# escalated to fatal errors by rebar3 / MongooseIM's
# `warnings_as_errors`:
#
#   * `nowarn_deprecated_catch` — legacy `(catch Expr)` form, used
#     throughout rebar3's vendored erlware_commons + MongooseIM.
#   * `nowarn_match_alias_pats` — aliased patterns where both sides
#     are constructors, e.g. erlware_commons/ec_date.erl:107
#     `{D1, T1} = {{Y, M, D}, {H, M1, S}}`. OTP-29 flags these as a
#     forward-incompat shape.
#   * `nowarn_unsafe_function` — OTP master added a `-unsafe`
#     directive (stdlib commit b783b44c8ba, Mar 2026) and marked
#     `os:cmd/1` unsafe. rebar3 3.24.0's vendored erlware_commons
#     (ec_git_vsn.erl) calls `os:cmd/1` in three spots; without the
#     suppress the bootstrap fails to compile on fresh master OTP.
#
# Stage-wide ENV so every erlc invocation (rebar3 bootstrap, rebar3
# building MongooseIM, rebar3 building each dep) inherits it.
# rebar3 passes ERL_COMPILER_OPTIONS through to its internal erlc
# calls; warnings_as_errors stays on but has nothing to escalate.
ENV ERL_COMPILER_OPTIONS='[nowarn_deprecated_catch, nowarn_match_alias_pats, nowarn_unsafe_function]'

ARG REBAR3_VERSION=3.24.0
RUN curl -fsSL "https://github.com/erlang/rebar3/archive/refs/tags/${REBAR3_VERSION}.tar.gz" \
        | tar xz -C /tmp \
    && cd "/tmp/rebar3-${REBAR3_VERSION}" \
    && ./bootstrap \
    && cp rebar3 /build/rebar3 \
    && rm -rf "/tmp/rebar3-${REBAR3_VERSION}"

# `./tools/configure with-all` writes configure.out + reltool vars.
# Defaults are fine for an in-memory single-node setup. `make rel`
# produces _build/prod/rel/mongooseim/.
RUN ./tools/configure with-all
RUN make rel

# --- runtime stage ---------------------------------------------------
FROM ${RUNTIME_IMAGE} AS runtime

# Same NIF runtime deps as the build stage minus the -dev packages.
# `|| true` on the apt-get install so we don't fail when running on a
# base image (Bullseye-based AWFY image) that doesn't have libssl3 in
# its repo — the build stage already produced binaries linked against
# that base's libssl, so the runtime libs we'd add here are no-ops on
# AWFY-image-based runs. On erlang:<tag>-slim (Bookworm) these are
# necessary because the slim image doesn't carry the dev libs the
# build stage installed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libexpat1 \
        zlib1g \
        ca-certificates \
        procps \
    && (apt-get install -y --no-install-recommends libssl3 libodbc2 \
        || apt-get install -y --no-install-recommends libssl1.1 libodbc1) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mongooseim
COPY --from=build /build/_build/prod/rel/mongooseim/ ./

# c2s on 5222 (XMPP), mongooseimctl uses the internal distribution
# socket which doesn't need to be exposed.
EXPOSE 5222

# `foreground` keeps mongooseimctl attached to the container's
# stdout/stderr, so Docker can manage the lifecycle and we can stream
# logs back to the host runner.
ENTRYPOINT ["./bin/mongooseimctl", "foreground"]
